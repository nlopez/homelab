# AWS CLI and SDK profiles for this repo. The dev shell points
# AWS_CONFIG_FILE here. The default and admin profiles get credentials from
# aws-sso-creds (devenv.nix), which opens the browser to sign in when the SSO
# session has expired, so no separate `aws sso login` step is needed.

[sso-session homelab]
sso_start_url = https://d-90678179f2.awsapps.com/start
sso_region = us-east-1
sso_registration_scopes = sso:account:access

# Read-only, for agents and plans.
[default]
credential_process = aws-sso-creds sso-read-only
region = us-east-1

# Applies: AWS_PROFILE=admin tofu apply
[profile admin]
credential_process = aws-sso-creds sso-admin
region = us-east-1

[profile sso-read-only]
sso_session = homelab
sso_account_id = 546422192262
sso_role_name = ReadOnlyAccess
region = us-east-1

[profile sso-admin]
sso_session = homelab
sso_account_id = 546422192262
sso_role_name = AdministratorAccess
region = us-east-1

# Break-glass only. Sign in with `aws login --profile root`.
[profile root]
login_session = arn:aws:iam::546422192262:root
region = us-east-1
