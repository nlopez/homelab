---
# eno1 carries the node's addresses and default route. SLAAC builds its IPv6 addresses
# from the host's token, so the ULA and global addresses end in the IPv4 host number.
netplan_ethernets:
  eno1:
    dhcp4: false
    dhcp6: false
    addresses: "{{ netplan_addresses }}"
    ipv6-address-token: "{{ netplan_ipv6_token }}"
    routes:
      - to: default
        via: 192.168.222.1
    nameservers:
      search:
        - lga1.radoncanyon.com
      addresses:
        - 192.168.222.1
netplan_remove_files:
  - 00-eno1.yaml

nfs_mounts:
  - {
      src: "nas1.lga1.radoncanyon.com:/mnt/etank/scratch",
      dest: "/mnt/scratch",
      opts: "rsize=1048576,wsize=1048576,hard,timeo=600,retrans=2,noresvport,_netdev,nofail"
    }
resolved_dns_servers:
  - 192.168.222.1
resolved_ignore_link_dns:
  - eno1

# The nodes stay out of tailnet DNS and routing: they answer the cluster, and
# resolved keeps pointing at the site gateway. tag:k8s belongs to the operator.
tailscale_accept_dns: false
tailscale_accept_routes: false
tailscale_ssh: true
tailscale_advertise_tags:
  - tag:home
  - tag:lga1
  # tag:ansible is what the Ansible workflow uses to reach these hosts over
  # Tailscale SSH. tailnet/tofu sets it too, because a tagged device can only
  # be given a new tag from the admin console or the API.
  - tag:ansible
