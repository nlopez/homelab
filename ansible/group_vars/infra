---
tailscale_accept_dns: false
# The sites reach each other over the gateways' WireGuard tunnel. Accepting
# the other site's subnet routes here would send this box's replies to
# cross-site clients through the tailnet instead of back through the tunnel.
tailscale_accept_routes: false
tailscale_ssh: true
tailscale_nameservers:
  - "{{ datadog_gateway_address }}"
  - 1.1.1.1
  - 2606:4700:4700::1111

# The Ansible workflow sets these from the items in the ci vault (see
# secrets.env); a local run falls back to the operator vault through the
# 1Password CLI.
datadog_api_key: >-
  {{ lookup('ansible.builtin.env', 'DD_API_KEY') or
  lookup('ansible.builtin.pipe',
  'op read op://eirjdyavzyx7tegpglsc2udq3a/4iqpxi5uzyzlkjq5br5fxt5glu/credential --account my.1password.com') }}
datadog_site: datadoghq.com
datadog_additional_groups: systemd-journal
datadog_config:
  hostname: "{{ inventory_hostname }}"
  tags:
    - "site:{{ inventory_hostname.split('.')[1] }}"
  logs_enabled: true
  logs_config:
    use_sourcehost_tag: true
  apm_config:
    enabled: false
  process_config:
    process_collection:
      enabled: true
  compliance_config:
    enabled: true
    host_benchmarks:
      enabled: true
  network_devices:
    namespace: "{{ inventory_hostname.split('.')[1] }}"
    netflow:
      enabled: true
      reverse_dns_enrichment_enabled: true
      listeners:
        - flow_type: netflow9
          port: 2057
runtime_security_config:
  enabled: false
compliance_config:
  enabled: true
  host_benchmarks:
    enabled: true
datadog_checks:
  journald:
    logs:
      - type: journald
  syslog:
    logs:
      - type: udp
        port: 5514
        source: syslog
        service: gateway
  snmp:
    init_config:
      use_remote_config_profiles: true
    instances:
      - ip_address: "{{ datadog_gateway_address }}"
        snmp_version: 3
        user: datadog
        authProtocol: SHA
        authKey: >-
          {{ lookup('ansible.builtin.env', 'SNMP_AUTHKEY_' ~ (inventory_hostname.split('.')[1] | upper)) or
          lookup('ansible.builtin.pipe',
          'op read op://eirjdyavzyx7tegpglsc2udq3a/' ~ snmp_v3_item_id ~ '/password --account my.1password.com') }}
        privProtocol: AES
        privKey: >-
          {{ lookup('ansible.builtin.env', 'SNMP_PRIVKEY_' ~ (inventory_hostname.split('.')[1] | upper)) or
          lookup('ansible.builtin.pipe',
          'op read op://eirjdyavzyx7tegpglsc2udq3a/' ~ snmp_v3_item_id ~ '/privkey --account my.1password.com') }}
        tags:
          - "target:gateway"
          - "geolocation:{{ inventory_hostname.split('.')[1] }}"
  tcp_check:
    init_config:
    instances:
      - name: gateway ssh
        host: "{{ datadog_gateway_address }}"
        port: 22
        collect_response_time: true
        tags:
          - "target:gateway"
      - name: internet https
        host: 1.1.1.1
        port: 443
        collect_response_time: true
        tags:
          - "target:internet"
