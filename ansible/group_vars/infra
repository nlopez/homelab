---
tailscale_accept_dns: false
tailscale_nameservers:
  - "{{ datadog_gateway_address }}"
  - 1.1.1.1
  - 2606:4700:4700::1111
# Both sites hold both zones, so either site can answer for either one. Names
# not listed here are forwarded to the site gateway and keep their LAN answers.
technitium_tailnet_zones:
  - lga1.radoncanyon.com
  - lga2.radoncanyon.com
technitium_tailnet_records:
  - name: gw.lga1.radoncanyon.com
    address: 100.83.144.88
  - name: gw.lga2.radoncanyon.com
    address: 100.86.37.97
  - name: nas1.lga1.radoncanyon.com
    address: 100.92.205.106
  - name: nas2.lga1.radoncanyon.com
    address: 100.73.101.17
  - name: odroid.lga1.radoncanyon.com
    address: 100.127.60.59
  - name: odroid.lga2.radoncanyon.com
    address: 100.110.65.2
  - name: dns.lga1.radoncanyon.com
    type: CNAME
    address: odroid.lga1.radoncanyon.com
  - name: dns.lga2.radoncanyon.com
    type: CNAME
    address: odroid.lga2.radoncanyon.com

technitium_proxy_acme_email: letsencrypt@aethertrail.com
technitium_proxy_upstream: "http://unix:{{ technitium_web_socket }}:"

datadog_api_key: >-
  {{ lookup('ansible.builtin.pipe',
  'op read op://evjh25ux2mnoufaut6qhvm2pdi/mpxer65frsgr6ugf7o7ebgas24/credential --account my.1password.com') }}
datadog_site: datadoghq.com
datadog_additional_groups: systemd-journal
datadog_config:
  hostname: "{{ inventory_hostname }}"
  tags:
    - "site:{{ inventory_hostname.split('.')[1] }}"
  logs_enabled: true
  logs_config:
    use_sourcehost_tag: true
  apm_config:
    enabled: false
  process_config:
    process_collection:
      enabled: true
  compliance_config:
    enabled: true
    host_benchmarks:
      enabled: true
  network_devices:
    namespace: "{{ inventory_hostname.split('.')[1] }}"
    netflow:
      enabled: true
      reverse_dns_enrichment_enabled: true
      listeners:
        - flow_type: netflow9
          port: 2057
runtime_security_config:
  enabled: false
compliance_config:
  enabled: true
  host_benchmarks:
    enabled: true
datadog_checks:
  journald:
    logs:
      - type: journald
  syslog:
    logs:
      - type: udp
        port: 5514
        source: syslog
        service: gateway
  snmp:
    init_config:
      use_remote_config_profiles: true
    instances:
      - ip_address: "{{ datadog_gateway_address }}"
        snmp_version: 3
        user: datadog
        authProtocol: SHA
        authKey: >-
          {{ lookup('ansible.builtin.pipe',
          'op read op://evjh25ux2mnoufaut6qhvm2pdi/' ~ snmp_v3_item_id ~ '/password --account my.1password.com') }}
        privProtocol: AES
        privKey: >-
          {{ lookup('ansible.builtin.pipe',
          'op read op://evjh25ux2mnoufaut6qhvm2pdi/' ~ snmp_v3_item_id ~ '/privkey --account my.1password.com') }}
        tags:
          - "target:gateway"
          - "geolocation:{{ inventory_hostname.split('.')[1] }}"
  tcp_check:
    init_config:
    instances:
      - name: gateway ssh
        host: "{{ datadog_gateway_address }}"
        port: 22
        collect_response_time: true
        tags:
          - "target:gateway"
      - name: internet https
        host: 1.1.1.1
        port: 443
        collect_response_time: true
        tags:
          - "target:internet"
  dns_check:
    init_config:
    instances:
      - name: technitium
        hostname: example.com
        nameserver: 127.0.0.1
        tags:
          - "target:technitium"
