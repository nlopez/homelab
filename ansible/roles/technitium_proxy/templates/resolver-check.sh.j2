#!/bin/bash
# Reports one gauge per resolver so a monitor can tell which one stopped
# answering the internal view, rather than only that resolution broke.
set -u
{% for resolver in technitium_proxy_check_resolvers %}
if [ "$(/usr/bin/dig +short +time=3 +tries=1 @{{ resolver.address }} {{ resolver.name }} A 2>/dev/null | head -1)" = "{{ resolver.answer }}" ]; then
  value=1
else
  value=0
fi
printf 'custom.dns.resolver.up:%s|g|#resolver:%s,resolver_host:%s,site:%s\n' \
  "$value" "{{ resolver.address }}" "{{ resolver.handler }}" "{{ technitium_proxy_site | default('unknown') }}" \
  > /dev/udp/{{ technitium_proxy_dogstatsd }}/8125
{% endfor %}
