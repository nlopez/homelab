#!/bin/sh
# Applies a full private-record snapshot to this gateway's Unbound.
# Installed by Ansible and run via the dns-sync sudoers rule with no
# arguments. Input is one RR per line on stdin:
#   pyrin.desertbluffs.com. 60 IN A 10.43.64.10
# The snapshot is authoritative for A/AAAA/CNAME under the zone: records
# absent from it are removed, and the saved include survives reboots.
set -eu

ZONE='{{ opnsense_dns_sync_zone }}.'
INCLUDE='{{ opnsense_dns_sync_include_file }}'
CONTROL='{{ opnsense_dns_sync_control_cmd }}'
CONF='{{ opnsense_dns_sync_unbound_conf }}'
MAX_RECORDS={{ opnsense_dns_sync_max_records }}

# Normalize whitespace and keep only records this script owns.
normalize() {
  awk -v zone="$ZONE" '
    BEGIN { gsub(/\./, "\\.", zone) }
    NF >= 5 && $1 ~ ("[.]" zone "$") && $3 == "IN" &&
    ($4 == "A" || $4 == "AAAA" || $4 == "CNAME") {
      printf "%s %s IN %s %s\n", $1, $2, $4, $5
    }' "$@"
}

snap=$(mktemp /tmp/dns-sync.XXXXXXXX)
have=$(mktemp /tmp/dns-sync.XXXXXXXX)
trap 'rm -f "$snap" "$have"' EXIT
cat > "$snap"

normalize "$snap" | sort > "$have"
input_count=$(grep -c . "$snap" || true)
count=$(wc -l < "$have" | tr -d ' ')
if [ "$count" -ne "$input_count" ]; then
  echo 'invalid record line' >&2
  exit 2
fi
if [ "$count" -gt "$MAX_RECORDS" ]; then
  echo "too many records: $count" >&2
  exit 2
fi

if ! "$CONTROL" -c "$CONF" list_local_data >/dev/null 2>&1; then
  echo 'unbound-control not reachable' >&2
  exit 3
fi

# Live-apply the diff first so a failed save never breaks serving.
"$CONTROL" -c "$CONF" list_local_data | normalize | sort > "$snap.live"
comm -13 "$snap.live" "$have" |
  while IFS= read -r rr; do "$CONTROL" -c "$CONF" local_data "$rr"; done
comm -23 "$snap.live" "$have" |
  while IFS= read -r rr; do "$CONTROL" -c "$CONF" local_data_remove "$rr"; done
rm -f "$snap.live"

# Persist so Unbound serves the same records after a restart.
printf 'server:\n' > "${INCLUDE}.new"
while IFS= read -r rr; do
  printf '    local-data: "%s"\n' "$rr" >> "${INCLUDE}.new"
done < "$have"
printf '    local-zone: "%s" transparent\n' "$ZONE" >> "${INCLUDE}.new"
mv "${INCLUDE}.new" "$INCLUDE"

echo "applied $count records"
