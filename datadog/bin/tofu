#!/usr/bin/env bash
# Runs tofu with the homelab-datadog 1Password Environment loaded. The
# secrets exist only in tofu's process, never in the shell.
set -euo pipefail

# Drop this directory from PATH wherever it sits, so `tofu` below resolves to
# the real binary even when something has been prepended ahead of it.
dir=$(cd "$(dirname "$0")" && pwd -P)
new=
IFS=:
for d in $PATH; do
  [ "$(cd "$d" 2>/dev/null && pwd -P)" = "$dir" ] || new=${new:+$new:}$d
done
unset IFS
PATH=$new

# Environments are outside the Automation-vault service account, so use app auth.
export OP_APP_AUTH=1
exec op run --no-masking --account my.1password.com --environment 4sirub7i26qlewsosiw4as3rbe -- tofu "$@"
