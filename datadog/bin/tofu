#!/usr/bin/env bash
# Runs tofu with the homelab-datadog 1Password Environment loaded. The
# secrets exist only in tofu's process, never in the shell.
set -euo pipefail
PATH="${PATH#"$(cd "$(dirname "$0")" && pwd):"}"
exec op run --account my.1password.com --environment 4sirub7i26qlewsosiw4as3rbe -- tofu "$@"
