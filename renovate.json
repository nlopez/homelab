{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "abandonments:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "major": {
    "dependencyDashboardApproval": true
  },
  "timezone": "America/New_York",
  "schedule": [
    "* 8 * * *"
  ],
  "minimumReleaseAge": "7 days",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 20,
  "enabledManagers": [
    "ansible-galaxy",
    "custom.regex",
    "helm-values",
    "github-actions",
    "nix",
    "pre-commit",
    "terraform"
  ],
  "pre-commit": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Helm chart versions in Application sources (HTTPS)",
      "managerFilePatterns": [
        "/^kubernetes/apps/[^/]+/application\\.yaml$/"
      ],
      "matchStrings": [
        "repoURL:\\s*['\"]?(?<registryUrl>https?://[^\\s'\"]+)['\"]?\\s*\\n\\s*chart:\\s*['\"]?(?<depName>[^\\s'\"]+)['\"]?\\s*\\n\\s*targetRevision:\\s*['\"]?(?<currentValue>[^\\s'\"]+)['\"]?"
      ],
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "{{{registryUrl}}}",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "description": "Update OCI-hosted Helm chart versions in Application sources",
      "managerFilePatterns": [
        "/^kubernetes/apps/[^/]+/application\\.yaml$/"
      ],
      "matchStrings": [
        "repoURL:\\s*['\"]?oci://(?<depName>[^\\s'\"]+)['\"]?\\s*\\n\\s*targetRevision:\\s*['\"]?(?<currentValue>[^\\s'\"]+)['\"]?"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "description": "Update Docker Hub OCI Helm chart versions (repoURL registry-1.docker.io + chart) in Application sources",
      "managerFilePatterns": [
        "/^kubernetes/apps/[^/]+/application\\.yaml$/"
      ],
      "matchStrings": [
        "repoURL:\\s*['\"]?registry-1\\.docker\\.io['\"]?\\s*\\n\\s*chart:\\s*['\"]?(?<depName>[^\\s'\"]+)['\"]?\\s*\\n\\s*targetRevision:\\s*['\"]?(?<currentValue>[^\\s'\"]+)['\"]?"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "description": "Update container images (image: / CNPG imageName:) in raw Kubernetes manifests",
      "managerFilePatterns": [
        "/^kubernetes/apps/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?:^|\\n)[ \\t]*(?:-[ \\t]+)?(?:image|imageName):[ \\t]*['\"]?(?<depName>[^:@\\s'\"]+)(?::(?<currentValue>[^@\\s'\"]+))?(?:@(?<currentDigest>sha256:[a-f0-9]+))?['\"]?"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^v?(?<major>\\d+)(?:\\.(?<minor>\\d+))?(?:\\.(?<patch>\\d+))?(?:\\.(?<build>\\d+))?(?<prerelease>[-.].*)?$"
    },
    {
      "customType": "regex",
      "description": "Update Go tools installed via `go install` in GitHub workflows (pre-commit hooks are handled by the pre-commit manager)",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?<depName>github\\.com/[^/\\s'\"@]+/[^/\\s'\"@]+)(?:/[^\\s'\"@]+)?@(?<currentValue>v[0-9][^\\s'\"\\]]*)"
      ],
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "Update the argocd-diff-preview image used by the manifest diff workflow",
      "managerFilePatterns": [
        "/^\\.github/workflows/kubernetes-argocd-diff\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?<depName>dagandersen/argocd-diff-preview):(?<currentValue>v[^\\s'\"]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "description": "Update the yt-dlp release media-toolbox pins in its Makefile, and the release link above it. The nightly build picks up new releases on its own; the pin is what pushes and manual runs build.",
      "managerFilePatterns": [
        "/^media-toolbox/Makefile$/"
      ],
      "matchStrings": [
        "YT_DLP_VERSION := (?<currentValue>\\S+)",
        "# https://github\\.com/yt-dlp/yt-dlp/releases/tag/(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "yt-dlp/yt-dlp",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^(?<major>\\d{4})\\.(?<minor>\\d{2})\\.(?<patch>\\d{2})(\\.(?<build>\\d+))?$"
    },
    {
      "customType": "regex",
      "description": "Update the bgutil-ytdlp-pot-provider release media-toolbox pins in its Makefile",
      "managerFilePatterns": [
        "/^media-toolbox/Makefile$/"
      ],
      "matchStrings": [
        "BGUTIL_YTDLP_POT_PROVIDER_VERSION := (?<currentValue>\\S+)"
      ],
      "depNameTemplate": "Brainicism/bgutil-ytdlp-pot-provider",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Update the pixivfe release the patched pixivfe image builds from. Merging the bump builds a new ghcr.io/nlopez/pixivfe tag, which the image rule then rolls out; a patch that no longer applies fails the build on the bump's PR.",
      "managerFilePatterns": [
        "/^pixivfe/Dockerfile$/"
      ],
      "matchStrings": [
        "ARG PIXIVFE_VERSION=(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "pixivfe/PixivFE",
      "datasourceTemplate": "gitlab-tags",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Group container image updates",
      "matchManagers": [
        "helm-values",
        "custom.regex"
      ],
      "groupName": "container image updates"
    },
    {
      "description": "One PR per Kubernetes app: its chart, images, and values together, so a PR touches one Application. Overrides the container image group above.",
      "matchFileNames": [
        "kubernetes/apps/**"
      ],
      "groupName": "{{lookup (split packageFileDir '/') 2}}",
      "groupSlug": "app-{{lookup (split packageFileDir '/') 2}}"
    },
    {
      "description": "Leave Helm values files to the helm-values manager; the image regex above is for raw manifests",
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "kubernetes/apps/*/values.yaml"
      ],
      "enabled": false
    },
    {
      "description": "Use regex versioning for linuxserver images which use version-X.Y.Z or version-vX.Y.Z tag format",
      "matchPackageNames": [
        "ghcr.io/linuxserver/**"
      ],
      "versioning": "regex:^version-v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(\\.(?<build>\\d+))?(-.*)?$"
    },
    {
      "description": "Use loose versioning for app images with non-semver tags",
      "matchPackageNames": [
        "caomingjun/warp",
        "docker.io/brainicism/bgutil-ytdlp-pot-provider",
        "ghcr.io/shaarli/shaarli",
        "registry.k8s.io/sig-storage/snapshot-controller"
      ],
      "versioning": "loose"
    },
    {
      "description": "media-toolbox CI publishes <yt-dlp version>-<CI run number> tags (e.g. 2026.10.26-42); the run number orders rebuilds of the same yt-dlp version (bgutil plugin bumps, flake changes). Other tags (bare version, commit SHAs) are ignored.",
      "matchPackageNames": [
        "ghcr.io/nlopez/media-toolbox"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<build>\\d+)$"
    },
    {
      "description": "We build media-toolbox ourselves, so there is no supply-chain reason to wait before picking up new tags",
      "matchPackageNames": [
        "ghcr.io/nlopez/media-toolbox"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "The pixivfe CI publishes <upstream version>-<CI run number> tags (e.g. v3.1.0-12); the run number orders rebuilds of the same upstream version (patch changes). Commit-SHA tags are ignored. We build it ourselves, and the upstream pin already waits out the release age.",
      "matchPackageNames": [
        "ghcr.io/nlopez/pixivfe"
      ],
      "versioning": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<build>\\d+)$",
      "minimumReleaseAge": null
    },
    {
      "description": "The Timekeeper server image is published by KamoTimestamps/timekeeper CI as <yyyy.mm.dd>-<CI run number> tags (e.g. 2026.11.20-2); the run number orders builds from the same day.",
      "matchPackageNames": [
        "ghcr.io/kamotimestamps/timekeeper-server"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<build>\\d+)$"
    },
    {
      "description": "nlopez/docker-icloudpd CI publishes 1.0.<run>_<dd-mm-yyyy>-icloudpd<version> tags; the run number orders builds. Pinned by tag and digest, since a digest alone leaves Renovate looking up a latest tag that doesn't exist.",
      "matchPackageNames": [
        "ghcr.io/nlopez/docker-icloudpd"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)_.*$",
      "minimumReleaseAge": null
    },
    {
      "description": "We build the Timekeeper server image ourselves, so there is no supply-chain reason to wait before picking up new tags",
      "matchPackageNames": [
        "ghcr.io/kamotimestamps/timekeeper-server"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "Timekeeper oak (production) is promoted by hand after the same build has run on ash, so Renovate only bumps ash.",
      "matchFileNames": [
        "kubernetes/apps/timekeeper-oak/**"
      ],
      "enabled": false
    },
    {
      "description": "icloudpd tags look like 1.0.1380_06-09-2026 (build number + date suffix)",
      "matchPackageNames": [
        "boredazfcuk/icloudpd",
        "docker.io/boredazfcuk/icloudpd"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)_\\d{2}-\\d{2}-\\d{4}$"
    },
    {
      "description": "cloudnative-vectorchord tags look like <pg-major>.<pg-minor>-<vchord x.y.z>; never cross a Postgres major version automatically",
      "matchPackageNames": [
        "ghcr.io/tensorchord/cloudnative-vectorchord"
      ],
      "versioning": "regex:^(?<compatibility>\\d+)\\.(?<major>\\d+)-(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)$"
    },
    {
      "description": "Ignore untagged or latest-pinned images that cannot meaningfully be updated",
      "matchPackageNames": [
        "bitnami/kubectl"
      ],
      "enabled": false
    },
    {
      "description": "Group dev tooling updates (pre-commit hooks, go install tools)",
      "matchManagers": [
        "pre-commit"
      ],
      "groupName": "dev tooling updates"
    },
    {
      "description": "Group the argocd-diff-preview CI image with dev tooling",
      "matchPackageNames": [
        "dagandersen/argocd-diff-preview"
      ],
      "groupName": "dev tooling updates"
    },
    {
      "description": "Keep the yamlfmt pre-commit hook and CI go install in lockstep",
      "matchPackageNames": [
        "github.com/google/yamlfmt",
        "google/yamlfmt"
      ],
      "groupName": "yamlfmt"
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions updates"
    },
    {
      "description": "Merge GitHub Actions and pre-commit hook updates on their own once ci-ok passes. They change only CI tooling, every PR re-runs the checks they affect, and the main ruleset still requires an up-to-date branch and a passing ci-ok. Majors still wait for dashboard approval; charts, images, providers, and flake.lock stay manual.",
      "matchManagers": [
        "github-actions",
        "pre-commit"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pinDigest"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    }
  ],
  "nix": {
    "lockFileMaintenance": {
      "enabled": true
    }
  }
}
