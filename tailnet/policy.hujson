{
  "groups": {
    "group:k8s-readers": [
      "nlopez@github"
    ],
    "group:k8s-admins": [
      "nlopez@github"
    ]
  },
  "tagOwners": {
    "tag:k8s-operator": [],
    "tag:k8s": [
      "tag:k8s-operator"
    ],
    "tag:work": [
      "autogroup:admin"
    ],
    "tag:home": [
      "autogroup:admin",
      "tag:k8s-operator"
    ],
    "tag:lga1": [
      "autogroup:admin",
      "tag:k8s-operator"
    ],
    "tag:lga2": [
      "autogroup:admin"
    ],
    "tag:admin": [
      "autogroup:admin"
    ],
    "tag:container": [
      "autogroup:admin"
    ],
    "tag:k8s-readers": [
      "autogroup:admin"
    ],
    "tag:exit": [
      "autogroup:admin",
      "tag:k8s-operator"
    ],
    "tag:timekeeper": [
      "autogroup:admin"
    ],
    "tag:ci": [
      "autogroup:admin"
    ]
  },
  "autoApprovers": {
    "exitNode": [
      "tag:exit"
    ],
    "services": {
      "tag:k8s": [
        "tag:k8s"
      ]
    },
    "routes": {
      "10.43.64.0/24": [
        "tag:k8s-operator",
        "tag:lga1"
      ],
      "fd54:571b:560a:1::/64": [
        "tag:lga1"
      ],
      "fd54:571b:560a:2::/64": [
        "tag:lga1"
      ],
      "fd54:571b:560a:3::/64": [
        "tag:lga1"
      ],
      "fd54:571b:560a:4364::/64": [
        "tag:lga1"
      ],
      "192.168.221.0/24": [
        "tag:lga1"
      ],
      "192.168.222.0/24": [
        "tag:lga1"
      ],
      "192.168.223.0/24": [
        "tag:lga1"
      ],
      "192.168.239.0/24": [
        "tag:lga2"
      ],
      "fd72:ce7b:d4a9:9511::/64": [
        "tag:lga2"
      ]
    }
  },
  "grants": [
    {
      "src": [
        "*"
      ],
      "dst": [
        "*"
      ],
      "ip": [
        "*"
      ]
    },
    // The apply-on-main runners join the tailnet with tag:ci. The src:*
    // grant above already gives them the full mesh, so until it no longer
    // does, this grant only documents what CI is meant to reach.
    {
      "src": [
        "tag:ci"
      ],
      "dst": [
        "tag:lga1",
        "tag:lga2"
      ],
      "ip": [
        "*"
      ]
    }
  ],
  "ssh": [
    {
      "action": "accept",
      "src": [
        "autogroup:member",
        "tag:admin"
      ],
      "dst": [
        "tag:k8s",
        "tag:k8s-operator",
        "tag:home",
        "tag:lga1",
        "tag:lga2",
        "tag:admin",
        "tag:container",
        "tag:exit",
        "tag:timekeeper",
        "tag:work"
      ],
      "users": [
        "autogroup:nonroot",
        "root"
      ]
    },
    {
      "action": "accept",
      "src": [
        "tag:home"
      ],
      "dst": [
        "tag:lga1",
        "tag:lga2"
      ],
      "users": [
        "dns-sync"
      ]
    }
  ],
  "randomizeClientPort": true,
  "nodeAttrs": [
    {
      "target": [
        "tag:work"
      ],
      "attr": [
        "nextdns:37848c",
        "disable-ipv4"
      ]
    },
    {
      "target": [
        "autogroup:member"
      ],
      "attr": [
        "funnel"
      ]
    },
    {
      "target": [
        "tag:admin"
      ],
      "attr": [
        "funnel"
      ]
    }
  ],
  "tests": [
    {
      "src": "tag:admin",
      "accept": [
        "10.43.64.10:443",
        "tag:lga1:22",
        "1.1.1.1:53"
      ]
    },
    {
      "src": "tag:lga2",
      "accept": [
        "10.43.64.10:443",
        "tag:home:443",
        "tag:lga1:22"
      ]
    },
    {
      "src": "tag:work",
      "accept": [
        "tag:home:22",
        "tag:home:443",
        "192.168.222.1:22"
      ]
    },
    {
      "src": "tag:ci",
      "accept": [
        "tag:lga1:443",
        "tag:lga2:443"
      ]
    }
  ]
}
