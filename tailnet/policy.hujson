{
  "groups": {
    "group:k8s-readers": [
      "nlopez@github"
    ],
    "group:k8s-admins": [
      "nlopez@github"
    ]
  },
  "tagOwners": {
    "tag:k8s-operator": [],
    // The Tailscale operator on the cloud DOKS cluster (digitalocean/) and
    // its proxies. Neither tag is a source in any grant, so cloud devices
    // can be reached from the tailnet but reach nothing on it, the home
    // networks behind the subnet routers included.
    "tag:cloud-operator": [],
    "tag:cloud": [
      "tag:cloud-operator"
    ],
    "tag:k8s": [
      "tag:k8s-operator"
    ],
    "tag:work": [
      "autogroup:admin"
    ],
    "tag:home": [
      "autogroup:admin",
      "tag:k8s-operator"
    ],
    "tag:lga1": [
      "autogroup:admin",
      "tag:k8s-operator"
    ],
    "tag:lga2": [
      "autogroup:admin"
    ],
    "tag:admin": [
      "autogroup:admin"
    ],
    "tag:container": [
      "autogroup:admin"
    ],
    "tag:k8s-readers": [
      "autogroup:admin"
    ],
    "tag:exit": [
      "autogroup:admin",
      "tag:k8s-operator"
    ],
    "tag:timekeeper": [
      "autogroup:admin"
    ],
    "tag:ci": [
      "autogroup:admin"
    ],
    "tag:ansible": [
      "autogroup:admin"
    ]
  },
  "autoApprovers": {
    "exitNode": [
      "tag:exit"
    ],
    "services": {
      "tag:k8s": [
        "tag:k8s"
      ]
    },
    "routes": {
      "10.43.64.0/24": [
        "tag:k8s-operator",
        "tag:lga1"
      ],
      "fd54:571b:560a:1::/64": [
        "tag:lga1"
      ],
      "fd54:571b:560a:2::/64": [
        "tag:lga1"
      ],
      "fd54:571b:560a:3::/64": [
        "tag:lga1"
      ],
      "fd54:571b:560a:4364::/64": [
        "tag:lga1"
      ],
      "192.168.221.0/24": [
        "tag:lga1"
      ],
      "192.168.222.0/24": [
        "tag:lga1"
      ],
      "192.168.223.0/24": [
        "tag:lga1"
      ],
      "192.168.239.0/24": [
        "tag:lga2"
      ],
      "fd72:ce7b:d4a9:9511::/64": [
        "tag:lga2"
      ]
    }
  },
  "grants": [
    // Full mesh for every tagged source and user device except tag:ci. The
    // apply-on-main runners are the one tag that must not inherit reach to
    // the whole tailnet, so the sources are listed instead of "*". Tags left
    // declared but unused (container, k8s-readers, timekeeper) keep their
    // mesh access in case a device picks one up later.
    {
      "src": [
        "autogroup:member",
        "tag:k8s-operator",
        "tag:k8s",
        "tag:work",
        "tag:home",
        "tag:lga1",
        "tag:lga2",
        "tag:admin",
        "tag:container",
        "tag:k8s-readers",
        "tag:exit",
        "tag:timekeeper",
        "tag:ansible"
      ],
      "dst": [
        "*"
      ],
      "ip": [
        "*"
      ]
    },
    // CI reaches only the two OPNsense APIs, over the subnet routers. The
    // authentik and datadog/dns stacks go over the public internet and need
    // nothing from the tailnet.
    {
      "src": [
        "tag:ci"
      ],
      "dst": [
        "192.168.222.1",
        "192.168.239.254"
      ],
      "ip": [
        "443"
      ]
    },
    // The split DNS resolvers for desertbluffs.com and radoncanyon.com
    // (tailnet/tofu/dns.tf). A runner on the tailnet sends every lookup for
    // those domains here, so
    // without this grant they time out.
    {
      "src": [
        "tag:ci"
      ],
      "dst": [
        "100.83.144.88",
        "100.86.37.97"
      ],
      "ip": [
        "tcp:53",
        "udp:53"
      ]
    },
    // The private Envoy gateway (envoy-proxy-private.yaml), for the arr
    // stack's Sonarr and Radarr APIs. The apps behind it still require their
    // API keys or authentik; a pull-request plan's only key is its GitHub OIDC
    // token, which the sonarr-api-ci and radarr-api-ci routes accept for GETs.
    {
      "src": [
        "tag:ci"
      ],
      "dst": [
        "10.43.64.10"
      ],
      "ip": [
        "443"
      ]
    },
    // The TrueNAS APIs on nas1 and nas2 (wss on 443), for the truenas stack.
    // Pull-request plans use the ci-pr user's keys, which hold only the
    // READONLY_ADMIN role (truenas/users.tf).
    {
      "src": [
        "tag:ci"
      ],
      "dst": [
        "192.168.222.149",
        "192.168.222.114"
      ],
      "ip": [
        "443"
      ]
    },
    // The Ansible workflow needs the packet filter to allow 22 as well as the
    // ssh rule below, which is what authorises the login as nlopez.
    {
      "src": [
        "tag:ci"
      ],
      "dst": [
        "tag:ansible"
      ],
      "ip": [
        "22"
      ]
    }
  ],
  "ssh": [
    {
      "action": "accept",
      "src": [
        "autogroup:member",
        "tag:admin"
      ],
      "dst": [
        "tag:k8s",
        "tag:k8s-operator",
        "tag:home",
        "tag:lga1",
        "tag:lga2",
        "tag:admin",
        "tag:container",
        "tag:exit",
        "tag:timekeeper",
        "tag:work"
      ],
      "users": [
        "autogroup:nonroot",
        "root"
      ]
    },
    {
      "action": "accept",
      "src": [
        "tag:home"
      ],
      "dst": [
        "tag:lga1",
        "tag:lga2"
      ],
      "users": [
        "dns-sync"
      ]
    },
    // The Ansible workflow logs in as nlopez and escalates with sudo, so
    // root login is not needed. tag:ansible is carried only by the four
    // hosts the playbooks configure: knode1 and knode2 also carry tag:lga1,
    // which would include every other lga1 device in an SSH rule.
    {
      "action": "accept",
      "src": [
        "tag:ci"
      ],
      "dst": [
        "tag:ansible"
      ],
      "users": [
        "nlopez"
      ]
    }
  ],
  "randomizeClientPort": true,
  "nodeAttrs": [
    {
      "target": [
        "tag:work"
      ],
      "attr": [
        "nextdns:37848c",
        "disable-ipv4"
      ]
    },
    {
      "target": [
        "autogroup:member"
      ],
      "attr": [
        "funnel"
      ]
    },
    {
      "target": [
        "tag:admin"
      ],
      "attr": [
        "funnel"
      ]
    }
  ],
  "tests": [
    {
      "src": "tag:admin",
      "accept": [
        "tag:cloud:443",
        "tag:cloud:22",
        "tag:cloud-operator:443"
      ]
    },
    {
      "src": "tag:cloud",
      "deny": [
        "192.168.222.1:443",
        "192.168.239.254:443",
        "192.168.222.149:443",
        "10.43.64.10:443",
        "10.43.64.20:443",
        "100.83.144.88:53",
        "100.86.37.97:53",
        "tag:home:443",
        "tag:lga1:22",
        "tag:k8s:443",
        "tag:admin:22"
      ]
    },
    {
      "src": "tag:cloud-operator",
      "deny": [
        "192.168.222.1:443",
        "192.168.239.254:443",
        "192.168.222.149:443",
        "10.43.64.10:443",
        "10.43.64.20:443",
        "100.83.144.88:53",
        "100.86.37.97:53",
        "tag:home:443",
        "tag:lga1:22",
        "tag:k8s:443",
        "tag:admin:22"
      ]
    },
    {
      "src": "tag:admin",
      "accept": [
        "10.43.64.10:443",
        "tag:lga1:22",
        "1.1.1.1:53"
      ]
    },
    {
      "src": "tag:lga2",
      "accept": [
        "10.43.64.10:443",
        "tag:home:443",
        "tag:lga1:22"
      ]
    },
    {
      "src": "tag:work",
      "accept": [
        "tag:home:22",
        "tag:home:443",
        "192.168.222.1:22"
      ]
    },
    {
      "src": "tag:ci",
      "accept": [
        "192.168.222.1:443",
        "192.168.239.254:443"
      ]
    },
    {
      "src": "tag:ci",
      "accept": [
        "tag:ansible:22"
      ]
    },
    {
      "src": "tag:ci",
      "accept": [
        "100.83.144.88:53",
        "100.86.37.97:53"
      ]
    },
    {
      "src": "tag:ci",
      "accept": [
        "10.43.64.10:443"
      ],
      "deny": [
        "10.43.64.10:80",
        "10.43.64.20:443"
      ]
    },
    {
      "src": "tag:ci",
      "accept": [
        "192.168.222.149:443",
        "192.168.222.114:443"
      ],
      "deny": [
        "192.168.222.149:22",
        "192.168.222.114:80"
      ]
    }
  ]
}
