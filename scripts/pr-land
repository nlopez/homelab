#!/usr/bin/env bash
# Lands a pull request whose plans you already compared with its description:
# checks ci-ok (scripts/pr-wait), squash-merges only the head commit you
# reviewed, then waits for every workflow run on main for the merge commit and
# reports each one. For each Apply job it says whether the Apply step ran: a
# green run whose Apply step was skipped applied nothing.
#
#   scripts/pr-wait <pr number>     # read every plan row first
#   scripts/pr-land <pr number> <reviewed head sha>
#
# The SHA is the one pr-wait printed with the plans you read (8 or more hex
# characters). ci-ok passes a plan that changes something unintended, so a
# head you haven't reviewed is never merged.
#
# Exit status: pr-wait's (1 ci-ok failed, 2 usage or API error, 4 timed out)
# before the merge; 6 the head isn't the one reviewed; after the merge, 0 every
# run passed, 1 a run failed, 2 the merge failed, 5 timed out waiting for runs
# (30 minutes).
# Needs `gh` authenticated for the repository (GH_TOKEN works too).
set -euo pipefail

usage="usage: scripts/pr-land <pr number> <reviewed head sha>"
pr="${1:?${usage}}"
reviewed="${2:?${usage}}"
if ! [[ "${reviewed}" =~ ^[0-9a-f]{8,40}$ ]]; then
  echo "${usage}: the SHA needs 8 to 40 hex characters." >&2
  exit 2
fi
repo="${GH_REPO:-$(git remote get-url origin | sed -E 's#(\.git)?$##; s#^.*github\.com[:/]##')}"
export GH_REPO="${repo}"
poll="${PR_LAND_POLL:-20}"

"$(dirname "$0")/pr-wait" "${pr}"

# pr-wait passed on this head; the merge fails if the head moved since.
read -r head title < <(gh api "repos/${repo}/pulls/${pr}" --jq '"\(.head.sha) \(.title)"')
if [[ "${head}" != "${reviewed}"* ]]; then
  echo "#${pr}'s head is ${head:0:8}, not the ${reviewed:0:8} you reviewed; nothing was merged. Read its plans (scripts/pr-wait ${pr}) and run pr-land with that SHA." >&2
  exit 6
fi
if ! merge="$(gh api -X PUT "repos/${repo}/pulls/${pr}/merge" -f merge_method=squash \
  -f sha="${head}" -f commit_title="${title} (#${pr})" --jq '.sha // empty')" || [ -z "${merge}" ]; then
  echo "Merging #${pr} at ${head:0:8} failed; nothing was merged." >&2
  exit 2
fi
echo "Merged #${pr} as ${merge:0:8}; waiting for its runs on main." >&2

# Done when the runs are all complete on two polls in a row, so a workflow
# that registers late still counts. A change no push workflow's paths match
# (docs, scripts) starts no runs: three empty polls in a row mean none.
deadline=$((SECONDS + 30 * 60)) quiet=0 empty=0 runs=""
while [ "${SECONDS}" -lt "${deadline}" ]; do
  sleep "${poll}"
  runs="$(gh api "repos/${repo}/actions/runs?head_sha=${merge}&event=push&per_page=100" \
    --jq '.workflow_runs[] | "\(.id)\t\(.status)\t\(.conclusion)\t\(.name)"')"
  if [ -z "${runs}" ]; then
    empty=$((empty + 1)) quiet=0
    if [ "${empty}" -ge 3 ]; then
      echo "No workflow ran on main for ${merge:0:8}; nothing to apply."
      exit 0
    fi
  elif ! cut -f2 <<<"${runs}" | grep -qvx completed; then
    empty=0 quiet=$((quiet + 1))
    [ "${quiet}" -ge 2 ] && break
  else
    empty=0 quiet=0
  fi
done
if [ "${quiet}" -lt 2 ]; then
  echo "Timed out waiting for the runs on ${merge:0:8}:" >&2
  printf '%s\n' "${runs}" | cut -f2- >&2
  exit 5
fi

failed=0
while IFS=$'\t' read -r id _ conclusion name; do
  echo "${name}: ${conclusion}"
  case "${conclusion}" in success|skipped|neutral) ;; *) failed=1 ;; esac
  gh api "repos/${repo}/actions/runs/${id}/jobs?per_page=100" \
    --jq '.jobs[] | select(.name | test("Apply$")) | "  \(.name): \(
      [.steps[] | select(.name == "Apply") | .conclusion] | first // "no Apply step"
      | if . == "skipped" then "Apply step skipped, nothing applied" elif . == "success" then "applied" else . end)"'
done <<<"${runs}"
exit "${failed}"
