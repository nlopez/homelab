+// Copyright 2023 - 2025, VnPower and the pixivFE contributors
+// SPDX-License-Identifier: AGPL-3.0-only
+
+package core
+
+import (
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"golang.org/x/net/html"
+)
+
+func TestExtractImageLinksNextData(t *testing.T) {
+	t.Parallel()
+
+	page := `<html><body><img src="https://s.pximg.net/logo.svg">
+<script id="__NEXT_DATA__" type="application/json">{"props":{"pageProps":{"assign":{"display_a":{"date":"202611","calendar":[
+{"day":0,"week":"Sun"},
+{"day":"01","img":"https://i.pximg.net/c/128x128/img-master/img/2026/10/31/02/11/01/151475433_p0_square1200.jpg"},
+{"day":"03","img":"https://i.pximg.net/c/128x128/custom-thumb/img/2026/11/13/02/52/41/151996977_p0_custom1200.jpg"},
+{"day":"04"}
+]}}}}}</script></body></html>`
+
+	doc, err := html.Parse(strings.NewReader(page))
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	req := httptest.NewRequest("GET", "/rankingCalendar", nil)
+
+	if future := extractImageLinks(req, doc, 2027, 1); len(future) != 0 {
+		t.Errorf("a month pixiv redirected to another has links: %q", future)
+	}
+
+	links := extractImageLinks(req, doc, 2026, 11)
+
+	if len(links) != 3 {
+		t.Fatalf("got %d links, want 3: %q", len(links), links)
+	}
+
+	if links[1] != "" {
+		t.Errorf("day 2 has no entry, got %q", links[1])
+	}
+
+	if got := extractArtworkID(links[0]); got != "151475433" {
+		t.Errorf("day 1 artwork ID = %q, want 151475433 (link %q)", got, links[0])
+	}
+
+	if got := extractArtworkID(links[2]); got != "151996977" {
+		t.Errorf("day 3 artwork ID = %q, want 151996977 (link %q)", got, links[2])
+	}
+}
