+func extractImageLinks(r *http.Request, doc *html.Node, year, month int) []string {
+	gq := goquery.NewDocumentFromNode(doc)
+
+	// ranking_log.php renders with Next.js and carries the calendar in
+	// __NEXT_DATA__ rather than in <img data-src> elements.
+	if script := gq.Find("script#__NEXT_DATA__"); script.Length() > 0 {
+		var data rankingLogNextData
+		if err := json.Unmarshal([]byte(script.Text()), &data); err == nil {
+			links := []string{}
+
+			// pixiv redirects a month after the current one to the current
+			// month; those months have no rankings yet.
+			if data.Props.PageProps.Assign.DisplayA.Date != fmt.Sprintf("%04d%02d", year, month) {
+				return links
+			}
+
+			for _, entry := range data.Props.PageProps.Assign.DisplayA.Calendar {
+				day, err := strconv.Atoi(strings.Trim(string(entry.Day), `"`))
+				if err != nil || day < 1 || day > 31 || entry.Img == "" {
+					continue
+				}
+
+				for len(links) < day {
+					links = append(links, "")
+				}
+
+				links[day-1] = RewriteImageURLs(r, entry.Img)
+			}
+
+			return links
+		}
+	}
