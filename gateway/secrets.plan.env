# 1Password references for pull-request plans, resolved with the read-only
# CI service account (OP_CI_PR_SERVICE_ACCOUNT_TOKEN) by .github/workflows/_tofu-stack.yaml.
# Each item is a read-only copy in the ci-pr vault.
# The keys belong to the ci-pr user (gateway/users.tf). Its
# user-config-readonly privilege rejects every config write with a 403.
TF_VAR_lga1_api_key=op://6foq5pqns6uslgstwbfoyyyftu/gateway-plan/lga1-api-key
TF_VAR_lga1_api_secret=op://6foq5pqns6uslgstwbfoyyyftu/gateway-plan/lga1-api-secret
TF_VAR_lga2_api_key=op://6foq5pqns6uslgstwbfoyyyftu/gateway-plan/lga2-api-key
TF_VAR_lga2_api_secret=op://6foq5pqns6uslgstwbfoyyyftu/gateway-plan/lga2-api-secret
